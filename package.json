{
  "name": "@aleksei-chernyi/pathmodel",
  "version": "0.1.1",
  "description": "Class-based data models addressed by dot paths, with decorators, validation and Vue 3 form rendering",
  "license": "MIT",
  "author": "Aleksei Chernyi <4er.aleksei@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksei-chernyi/pathmodel.git"
  },
  "homepage": "https://github.com/aleksei-chernyi/pathmodel#readme",
  "bugs": {
    "url": "https://github.com/aleksei-chernyi/pathmodel/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pathmodel",
    "dot-path",
    "vue",
    "forms",
    "decorators",
    "typescript",
    "schema"
  ],
  "sideEffects": [
    "dist/**/*.js"
  ],
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^4.0.8",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  }
}
